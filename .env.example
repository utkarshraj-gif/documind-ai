# Proofline Environment Configuration

# Database Configuration
# PostgreSQL production/local connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proofline
# SQLite fallback for quick local testing without PostgreSQL server:
DATABASE_URL=sqlite:///./proofline.db

# Authentication / JWT
JWT_SECRET=proofline_super_secret_jwt_key_2026_dev_mode
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# AI_PROVIDER options: gemini, local
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Application Configuration
APP_NAME=Proofline
DEBUG=True
PORT=8000
HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./storage/uploads
